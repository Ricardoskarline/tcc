# =============================================================================
# Configuração do Servidor FastAPI
# =============================================================================
HOST=0.0.0.0
PORT=8089

# =============================================================================
# Configuração do Firewall de Intenções
# =============================================================================
# Limite máximo de caracteres aceitos para análise (proteção contra DoS)
MAX_INPUT_LENGTH=10000

# =============================================================================
# Configuração dos Motores de Segurança Avançados
# =============================================================================
# Controle de ativação das camadas de verificação e modelo semântico dedicado
ENABLE_AST_FIREWALL=true
ENABLE_SEMANTIC_FIREWALL=true
SEMANTIC_MODEL=deepseek-chat

# =============================================================================
# Integração com APIs de IA (Opcional)
# =============================================================================
# Descomente e configure uma das opções abaixo para usar API real
# Se nenhuma chave estiver configurada, o sistema usa o mock interno

# DeepSeek API
DEEPSEEK_API_KEY=sua_chave_deepseek_aqui
DEEPSEEK_MODEL=deepseek-chat

# OpenAI API
# OPENAI_API_KEY=sua_chave_openai_aqui
# OPENAI_MODEL=gpt-4-turbo-preview

# Google Gemini API
# GOOGLE_API_KEY=sua_chave_google_gemini_aqui
# GOOGLE_MODEL=gemini-2.5-pro

# =============================================================================
# Configuração de Resiliência e Retries de APIs
# =============================================================================
# Políticas para tratamento de falhas e reconexão com serviços externos de IA
API_MAX_RETRIES=3
API_RETRY_DELAY_SECONDS=1.0

# =============================================================================
# Configuração de Logging
# =============================================================================
LOG_LEVEL=INFO
FIREWALL_AUDIT_LOG=firewall_audit.log